POSTGRES_USER=m6user
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=m6_trips
DATABASE_URL="postgresql://m6user:cambiar_esta_clave@localhost:5433/m6_trips?schema=public"
CLIENT_NO_SHOW_MINUTES=5

# Integracion con M8 (QR de inicio de viaje - RF-6.4 / RNF-13).
# Sin M8_API_URL se usa la simulacion local en memoria.
# M8_API_URL=http://localhost:3000
# M8_TIMEOUT_MS=3000
# M8_MAX_RETRIES=1
# M8_RETRY_DELAY_MS=150
# Token de servicio de M6 hacia otros modulos (client_credentials).
# El secreto de desarrollo del cliente grupo-12 esta en keycloak/realm-config/ds-2026-realm.json.
AUTH_CLIENT_ID=grupo-12
AUTH_CLIENT_SECRET=
# AUTH_TOKEN_URL=http://localhost:8081/realms/ds-2026-realm/protocol/openid-connect/token
# Alternativa solo para desarrollo: forzar un token fijo.
# M8_SERVICE_TOKEN=

# Atajos de demo (Bearer SYSTEM, X-Actor-Role). Solo desarrollo: en un entorno publicado va en false.
ENABLE_DEMO_AUTH=true

# Validacion del JWT emitido por M1 (Keycloak).
# Por defecto se usa el realm de la catedra en el puerto 8080.
# Con el Keycloak del modulo (docker compose) es http://localhost:8081/realms/ds-2026-realm.
# AUTH_ISSUER=http://localhost:8080/realms/ds-2026-realm
# AUTH_JWKS_URI=http://localhost:8080/realms/ds-2026-realm/protocol/openid-connect/certs
# AUTH_AUDIENCE=
# AUTH_JWKS_TIMEOUT_MS=3000
# AUTH_JWKS_CACHE_MS=600000
# AUTH_CLOCK_TOLERANCE_SEC=5
