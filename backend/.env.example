POSTGRES_USER=m6user
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=m6_trips
DATABASE_URL="postgresql://m6user:cambiar_esta_clave@localhost:5433/m6_trips?schema=public"
CLIENT_NO_SHOW_MINUTES=5
# RabbitMQ (RNF-10). Sin esta variable los eventos quedan pendientes en la outbox y no se envian.
RABBITMQ_URL=amqp://m6:m6_dev@localhost:5672
# Integración con M8 (Notificaciones / Validación QR - RF-6.4 / RNF-06 / RNF-13). Opcional en desarrollo.
# M8_API_URL=http://localhost:3000
# M8_TIMEOUT_MS=3000
# M8_SERVICE_TOKEN=SYSTEM
# M8_MAX_RETRIES=1
# M8_RETRY_DELAY_MS=150
# Atajos de demo (Bearer SYSTEM, X-Actor-Role). Solo desarrollo: en cualquier entorno publicado va en false.
ENABLE_DEMO_AUTH=true
# Validacion del JWT emitido por M1 (Keycloak). Sin AUTH_ISSUER se usa el realm compartido.
# AUTH_ISSUER=http://localhost:8080/realms/ds-2026-realm
# AUTH_JWKS_URI=http://localhost:8080/realms/ds-2026-realm/protocol/openid-connect/certs
# AUTH_AUDIENCE=
# AUTH_JWKS_TIMEOUT_MS=3000
# AUTH_JWKS_CACHE_MS=600000
# AUTH_JWKS_COOLDOWN_MS=5000
# AUTH_CLOCK_TOLERANCE_SEC=5

# Telemetria para OpsBoard. Al definir el endpoint se activan metricas, trazas y logs OTLP/HTTP.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=m6-grupo12
# OTEL_RESOURCE_ATTRIBUTES=grupo=12
# OTEL_METRIC_EXPORT_INTERVAL=5000
