// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TripState {
  PENDING_ARRIVAL
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("trip_state")
}

enum VehicleType {
  AUTO
  MOTO

  @@map("vehicle_type")
}

enum ActorRole {
  CLIENT
  DRIVER
  OPERATOR
  SYSTEM

  @@map("actor_role")
}

enum CancellationReason {
  CHANGE_OF_PLANS
  EXCESSIVE_DELAY
  DRIVER_NO_SHOW
  CLIENT_NO_SHOW
  VEHICLE_PROBLEM
  ORIGIN_UNREACHABLE
  SECURITY_INCIDENT
  ADMINISTRATIVE_BLOCK
  OTHER

  @@map("cancellation_reason")
}

enum TripAction {
  CREATE
  REGISTER_ARRIVAL
  START
  COMPLETE
  CANCEL

  @@map("trip_action")
}

enum RatingAuthor {
  CLIENT
  DRIVER

  @@map("rating_author")
}

model Trip {
  id                   String             @id @default(uuid()) @db.Uuid
  requestId            String             @unique @map("request_id") @db.Uuid
  clientId             String             @map("client_id") @db.Uuid
  driverId             String             @map("driver_id") @db.Uuid
  vehicleId            String             @map("vehicle_id") @db.Uuid
  vehicleType          VehicleType        @map("vehicle_type")
  reservationId        String?            @map("reservation_id") @db.Uuid
  originAddress        String?            @map("origin_address")
  destinationAddress   String?            @map("destination_address")
  originLatitude       Float              @map("origin_latitude")
  originLongitude      Float              @map("origin_longitude")
  destinationLatitude  Float              @map("destination_latitude")
  destinationLongitude Float              @map("destination_longitude")
  state                TripState          @default(PENDING_ARRIVAL)
  version              Int                @default(1)
  arrivedAt            DateTime?          @map("arrived_at")
  startedAt            DateTime?          @map("started_at")
  completedAt          DateTime?          @map("completed_at")
  cancelledAt          DateTime?          @map("cancelled_at")
  cancelledBy          ActorRole?         @map("cancelled_by")
  cancellationReason   CancellationReason? @map("cancellation_reason")
  cancellationDetail   String?             @map("cancellation_detail")
  cancelledFromState   TripState?          @map("cancelled_from_state")
  requiresRedispatch   Boolean?            @map("requires_redispatch")
  distanceKm           Float?             @map("distance_km")
  durationMinutes      Int?               @map("duration_minutes")
  durationSeconds      Int?               @map("duration_seconds")
  finalLatitude        Float?             @map("final_latitude")
  finalLongitude       Float?             @map("final_longitude")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  events               TripEventHistory[]
  ratings              TripRating[]

  @@index([clientId])
  @@index([driverId, state])
  @@map("trips")
}

model TripEventHistory {
  id        String      @id @default(uuid()) @db.Uuid
  tripId    String      @map("trip_id") @db.Uuid
  trip      Trip        @relation(fields: [tripId], references: [id])
  sequence  Int
  fromState TripState?  @map("from_state")
  state     TripState
  action    TripAction
  actorId   String      @map("actor_id")
  actorRole ActorRole   @map("actor_role")
  reason    String?
  detail    String?
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([tripId, sequence])
  @@index([tripId, createdAt])
  @@map("trip_event_history")
}

model TripRating {
  id        String       @id @default(uuid()) @db.Uuid
  tripId    String       @map("trip_id") @db.Uuid
  trip      Trip         @relation(fields: [tripId], references: [id])
  ratedBy   RatingAuthor @map("rated_by")
  raterId   String       @map("rater_id") @db.Uuid
  ratedId   String       @map("rated_id") @db.Uuid
  score     Int
  comment   String?      @db.VarChar(500)
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([tripId, ratedBy])
  @@map("trip_ratings")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String   @map("actor_id")
  key            String   @db.VarChar(200)
  fingerprint    String
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  responseEtag   String?  @map("response_etag")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  @@unique([actorId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}