POSTGRES_USER=m6user
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=m6_trips

# Al correr backend en Docker, el collector de OpsBoard escucha en el host.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
DATABASE_URL="postgresql://m6user:cambiar_esta_clave@localhost:5433/m6_trips?schema=public"
CLIENT_NO_SHOW_MINUTES=5
# Integración con M8 (Notificaciones / Validación QR - RF-6.4 / RNF-06 / RNF-13). Opcional en desarrollo.
# M8_API_URL=http://localhost:3000
# M8_TIMEOUT_MS=3000
# M8_SERVICE_TOKEN=SYSTEM
# M8_MAX_RETRIES=1
# M8_RETRY_DELAY_MS=150
# Atajos de demo (Bearer SYSTEM, X-Actor-Role). Solo desarrollo: en cualquier entorno publicado va en false.
# El compose del modulo lo apaga por defecto; para la demo del panel se puede poner true.
ENABLE_DEMO_AUTH=false

# Keycloak de M6 (hace de M1). Valores de desarrollo; se pueden pisar.
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ds2026
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev
# Emisor publicado y JWKS interno. Solo hace falta si se cambia el host o el puerto.
# AUTH_ISSUER=http://localhost:8081/realms/ds-2026-realm
# AUTH_JWKS_URI=http://keycloak:8080/realms/ds-2026-realm/protocol/openid-connect/certs

# RabbitMQ de M6 (RNF-10). Valores de desarrollo; se pueden pisar.
RABBITMQ_USER=m6
RABBITMQ_PASSWORD=m6_dev
# Solo para usar un broker compartido; si no se define, el backend en Docker usa el propio.
# RABBITMQ_URL=amqp://usuario:clave@servidor:5672